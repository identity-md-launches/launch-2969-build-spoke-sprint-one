{
  "name": "spoke-sprint",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "validate:browser": "node scripts/validate-browser.mjs",
    "validate:live": "node scripts/check-live.mjs",
    "validate:api": "node --experimental-strip-types scripts/check-api.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "axe-core": "^4.10.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
